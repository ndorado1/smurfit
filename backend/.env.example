# OpenAI (modelo comercial)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.1

# OpenRouter (modelo "local" — open-source via API). https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=qwen/qwen3.5-9b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# URL publica de la app (para attribution headers de OpenRouter)
APP_URL=https://llm.innovatec.co

# Google Gemini (para embeddings - reutiliza el FAISS del modulo 1)
GOOGLE_API_KEY=...

# PostgreSQL (easypanel)
DB_HOST=easypanel.innovatec.co
DB_PORT=5438
DB_NAME=llm
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# LangSmith — observabilidad / tracing de LangChain (opcional pero recomendado)
# Crea cuenta gratis en https://smith.langchain.com y genera API key en Settings -> API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=smurfit-agente
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
DB_PASSWORD=tu_password_aqui
