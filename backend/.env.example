# ── LLMs ──────────────────────────────────────────────────────────────────────
# OpenAI (modelo comercial)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.1

# OpenRouter (modelo open-source - Qwen)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=qwen/qwen3.5-9b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google Gemini (embeddings multimodales de la KB)
GOOGLE_API_KEY=...

# ── Bases de datos ────────────────────────────────────────────────────────────
# Postgres del UI web (chats/messages — espejo de display)
DB_HOST=easypanel.innovatec.co
DB_PORT=5438
DB_NAME=llm
DB_USER=postgres
DB_PASSWORD=...

# Postgres + pgvector (KB vectorial + checkpointer de memoria del agente)
KB_DB_HOST=easypanel.innovatec.co
KB_DB_PORT=5439
KB_DB_NAME=supabase
KB_DB_USER=postgres
KB_DB_PASSWORD=...

# ── WhatsApp (Meta Cloud API) ─────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=...
WHATSAPP_WABA_ID=...
WHATSAPP_TOKEN=...
WHATSAPP_VERIFY_TOKEN=westrock
WHATSAPP_PROVIDER=commercial
GRAPH_API_VERSION=v21.0
# WHATSAPP_APP_SECRET=...   # opcional: valida la firma X-Hub-Signature-256

# ── Observabilidad (opcional) ─────────────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=smurfit-agente
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# URL publica (attribution headers de OpenRouter)
APP_URL=https://llm.innovatec.co
